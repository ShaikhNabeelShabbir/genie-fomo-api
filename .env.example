# ---------------------------------------------------------------------------
# genie-fomo API — copy to .env and fill in. Every key is optional; the service
# reports per-provider status at /v1/health and degrades honestly without them.
# ---------------------------------------------------------------------------

# Ethereum transactions. Free key: https://etherscan.io/apis
# The free tier does NOT cover BSC or Base.
ETHERSCAN_KEY=

# Solana address resolution + transactions. Free key: https://helius.dev
# Free tier: 1M credits/month, 10 req/s (DAS 2 req/s).
HELIUS_SOLANA_KEY=

# EVM address resolution on all four chains, plus BSC/Base transactions.
# Key: https://bitquery.io — optional. Without it, resolution falls back to
# Blockscout (Robinhood + Ethereum, large positions only) and BSC/Base go dark.
BITQUERY_KEY=

# Trader directory to serve. Defaults to ./data/wallet.full.data.json.
# WALLETS_FILE=/absolute/path/to/wallet.full.data.json

# OPTIONAL / not needed today. Leaving this blank means open access, which is the
# current intended setup. Setting it later requires every request to send a matching
# X-API-Key header — no code change needed. See PROD-STEPS.md "Future hardening".
# GENIE_API_KEY=

PORT=8787

# Comma-separated allowed browser origins. Leave blank to allow any (local dev only).
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
