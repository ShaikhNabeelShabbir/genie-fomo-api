{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "scripts/lib/dist",
    "rootDir": "scripts/lib/ts",
    "types": ["node"]
  },
  "include": ["scripts/lib/ts/**/*.ts"]
}
