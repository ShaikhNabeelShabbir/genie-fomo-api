{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node"],
    "paths": { "https://deno.land/x/postgresjs@v3.4.4/mod.js": ["../node_modules/postgres/types/index.d.ts"] }
  },
  "include": ["src/**/*.ts"]
}
